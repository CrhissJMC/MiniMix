<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Sólo para NotifyIcon (icono de la bandeja). Se quitan sus usings globales para no chocar con WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Mini-Mixer</Product>
    <AssemblyTitle>Mini-Mixer</AssemblyTitle>
    <Company>CrhissJMC</Company>
    <Copyright>CrhissJMC</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MiniMixer</RootNamespace>
    <AssemblyName>MiniMixer</AssemblyName>
    <!-- La captura por proceso usa P/Invoke con estructuras PROPVARIANT de 64 bits -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
